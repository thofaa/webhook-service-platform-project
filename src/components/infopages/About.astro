---
import { getEntry } from "astro:content";

const aboutEntry = await getEntry("about", "index");
const {
  tagline,
  title,
  description,
  storyTitle,
  story,
  stats,
  values,
  team,
  ctaTitle,
  ctaButtonText,
  ctaButtonUrl,
} = aboutEntry.data;
---

<section class="overflow-hidden">
  <div class="px-8 pt-24 mx-auto md:px-12 lg:px-24 max-w-7xl">
    <div class="max-w-2xl text-center mx-auto lg:text-balance">
      <p class="text-sm leading-normal font-bold uppercase text-accent-600">
        {tagline}
      </p>
      <h1
        class="text-xl leading-tight tracking-tight sm:text-2xl md:text-3xl capitalize lg:text-4xl mt-4 font-medium text-base-900 lg:text-balance">
        {title}
      </h1>
      <p class="text-base leading-normal mt-4 text-base-500 font-medium">
        {description}
      </p>
    </div>
  </div>
</section>

<section>
  <div class="px-8 py-20 mx-auto md:px-12 lg:px-24 max-w-7xl">
    <div class="max-w-3xl mx-auto text-center">
      <h2
        class="text-xl leading-tight tracking-tight sm:text-2xl md:text-3xl capitalize lg:text-4xl font-medium text-base-900 lg:text-balance">
        {storyTitle}
      </h2>
      <p class="text-base leading-normal mt-6 text-base-500 lg:text-balance">
        {story}
      </p>
    </div>

    <dl
      class="grid grid-cols-2 gap-x-6 gap-y-12 lg:grid-cols-4 lg:gap-y-16 mt-20">
      {
        stats.map(({ value, label }) => (
          <div class="text-center">
            <dt class="text-3xl font-semibold tracking-tight text-accent-600 sm:text-4xl">
              {value}
            </dt>
            <dd class="mt-2 text-base leading-normal text-base-500 font-medium">
              {label}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<section class="bg-accent-600 py-20 text-white">
  <div class="max-w-7xl mx-auto px-8 md:px-12 lg:px-24">
    <div class="text-center mb-14">
      <h2
        class="text-xl leading-tight tracking-tight sm:text-2xl md:text-3xl capitalize lg:text-4xl font-medium text-white">
        What we value
      </h2>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        values.map(({ title, description }) => (
          <div
            class="bg-white/90 text-gray-800 p-8 rounded-2xl hover:scale-[1.025] transition ease-linear">
            <h3 class="text-lg font-semibold mb-2">{title}</h3>
            <p class="text-base font-medium">{description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section>
  <div class="px-8 py-24 mx-auto md:px-12 lg:px-24 max-w-7xl">
    <div class="text-center max-w-2xl mx-auto lg:text-balance">
      <h2
        class="text-xl leading-tight tracking-tight sm:text-2xl md:text-3xl capitalize lg:text-4xl font-medium text-base-900 lg:text-balance">
        Meet the team
      </h2>
    </div>
    <div class="grid gap-10 mt-12 sm:grid-cols-2 lg:grid-cols-4">
      {
        team.map(({ name, role, bio }) => (
          <div class="text-center">
            <div
              class="w-16 h-16 mx-auto flex items-center justify-center bg-accent-100 text-accent-600 rounded-full text-lg font-semibold">
              {name.split(" ").map((n) => n[0]).join("")}
            </div>
            <h3 class="text-lg font-medium text-base-900 mt-4">{name}</h3>
            <p class="text-sm font-bold uppercase text-accent-600 mt-1">
              {role}
            </p>
            <p class="text-base leading-normal mt-3 text-base-500 font-medium">
              {bio}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="pb-4">
  <div class="px-8 py-20 mx-auto md:px-12 lg:px-24 max-w-7xl">
    <div
      class="bg-base-950 text-white rounded-2xl px-8 py-16 text-center lg:px-24">
      <h2
        class="text-xl leading-tight tracking-tight sm:text-2xl md:text-3xl capitalize lg:text-4xl font-medium text-white lg:text-balance">
        {ctaTitle}
      </h2>
      <a
        href={ctaButtonUrl}
        class="inline-flex items-center justify-center transition-all duration-200 focus:ring-2 focus:outline-none text-white bg-accent-600 hover:bg-accent-700 focus:ring-accent-500/50 h-10 px-6 py-3 text-base font-medium rounded-lg mt-10">
        {ctaButtonText}
      </a>
    </div>
  </div>
</section>